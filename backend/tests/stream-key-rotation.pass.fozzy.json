{
  "version": 1,
  "name": "stream-key-rotation-pass",
  "steps": [
    {
      "type": "proc_when",
      "cmd": "python3",
      "args": [
        "-c",
        "import json, urllib.request; data=json.load(urllib.request.urlopen('http://127.0.0.1:8080/health')); assert data['status'] == 'ok' and data['database'] is True; print('health-ok')"
      ],
      "exit_code": 0,
      "times": 1
    },
    {
      "type": "proc_when",
      "cmd": "python3",
      "args": [
        "tests/stream-key-rotation-check.py"
      ],
      "exit_code": 0,
      "stdout": "stream-key|rotate|invalidate|reconnect\n",
      "times": 1
    },
    {
      "type": "proc_spawn",
      "cmd": "python3",
      "args": [
        "tests/stream-key-rotation-check.py"
      ],
      "expect_exit": 0,
      "expect_stdout": "stream-key|rotate|invalidate|reconnect\n"
    }
  ]
}
