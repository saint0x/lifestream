{
  "package_id": "vanta-native-encode-macos",
  "helper_kind": "encode",
  "platform": "macos",
  "display_name": "Vanta Native Encode Helper for macOS",
  "binary_path": "$VANTA_OBS_ROOT/native/encode/macos/bin/vanta-native-encode",
  "install_path": "$VANTA_OBS_ROOT/native/encode/macos/package/VantaNativeEncode.pkg",
  "transports": ["stdio", "localhost"],
  "signing": {
    "required": true,
    "identity_env": "VANTA_MACOS_DEVELOPER_ID",
    "notarization_required": true,
    "entitlement_profile": "encode-macos.entitlements"
  },
  "permissions": ["video-encode", "filesystem-media-output"]
}
